# Server
PORT=3000
NODE_ENV=development

# Database (Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# JWT (RS256 keypair)
JWT_PRIVATE_KEY=<PEM private key>
JWT_PUBLIC_KEY=<PEM public key>
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# Apple Sign In
APPLE_CLIENT_ID=com.afterparty.ios
APPLE_TEAM_ID=XXXXXXXXXX

# Google Sign In
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# WebAuthn
WEBAUTHN_RP_NAME=Afterparty
WEBAUTHN_RP_ID=afterparty.app
WEBAUTHN_ORIGIN=https://afterparty.app

# AWS S3
AWS_ACCESS_KEY_ID=xxxx
AWS_SECRET_ACCESS_KEY=xxxx
AWS_REGION=us-east-1
S3_BUCKET_NAME=afterparty-staging-images

# APNs
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_PRIVATE_KEY=<.p8 key contents>
APNS_BUNDLE_ID=com.afterparty.ios
APNS_ENVIRONMENT=development

# FCM
FCM_PROJECT_ID=afterparty-xxxxx
FCM_SERVICE_ACCOUNT_KEY=<JSON or path>

# Rate Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
POKE_RATE_LIMIT_MAX=3
